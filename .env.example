# Copier en .env (jamais versionné) et renseigner. Les variables marquées « requis »
# bloquent le démarrage si elles sont vides.

# Base PostgreSQL (registre unique des paris réels) — requis
BET_DB_PASSWORD=
# Compte d'administration de l'API (HTTP Basic) — requis
BET_ADMIN_USER=admin
BET_ADMIN_PASSWORD=
# Jeton partagé backend ↔ moteur Python — requis
BET_ENGINE_TOKEN=
BET_HTTP_PORT=18082

# Cotes : fixture (DEMO / SYNTHÉTIQUE), theoddsapi, ou les deux : theoddsapi,fixture
ODDS_PROVIDER=fixture
THE_ODDS_API_KEY=
# Compétitions The Odds API séparées par des virgules, ex. soccer_france_ligue_one,tennis_atp_paris
SPORTS_ODDS_COMPETITIONS=
# Intervalle entre deux cycles (ms) ; 900000 = 15 min. Chaque cycle consomme 1 crédit par compétition.
SPORTS_COLLECT_INTERVAL_MS=900000
# Budget de crédits The Odds API (offre gratuite = 500/mois) : chaque compétition est
# interrogée au plus une fois par ODDS_MIN_INTERVAL_MINUTES (1 crédit), les scores au plus
# une fois par ODDS_SCORES_INTERVAL_MINUTES (2 crédits, seulement pour les matchs prédits),
# et tout s'arrête quand le quota restant atteint ODDS_QUOTA_FLOOR.
# 1 compétition à 120 min ≈ 372 crédits/mois ; 2 compétitions : passer à 240 min.
ODDS_MIN_INTERVAL_MINUTES=120
ODDS_SCORES_INTERVAL_MINUTES=720
ODDS_QUOTA_FLOOR=20

# Actualité des équipes (blessés, compositions) : clé gratuite sur dashboard.api-football.com
# (100 requêtes/jour). Sans clé, aucune sélection réelle ne peut être proposée.
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=90

# Telegram (long polling, aucun port public). Liste stricte de chats privés autorisés.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_SIMULATOR=false

# 1 = installer le moteur depuis ai-engine/wheels (proxy/antivirus qui intercepte TLS)
OFFLINE_WHEELS=0
